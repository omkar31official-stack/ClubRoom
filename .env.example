# ========================================================
# ClubRoom Configuration Environment Variables
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication
# Secret used for signing organizer session JWTs
JWT_SECRET=clubroom-super-secure-production-secret-change-me-2026

# Database Storage
# By default, stored on the verified Storage partition:
DATABASE_PATH=/media/omkar/Storage/Projects/meeting/database/clubroom.sqlite

# LiveKit WebRTC Video Infrastructure (Optional)
# Obtain free cloud credentials at https://cloud.livekit.io (Free Tier: 50GB bandwidth / mo)
# When left empty, ClubRoom automatically operates in high-performance local WebRTC mode!
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Storage Partition Cache Enforcements
TMPDIR=/media/omkar/Storage/Projects/meeting/.tmp
npm_config_cache=/media/omkar/Storage/Projects/meeting/.cache/npm

